<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema">
  <element name="data">
    <complexType>
      <sequence>
        <element name="person" maxOccurs="unbounded">
          <complexType>
            <sequence>
              <element name="name" type="string" />
              <element name="age" type="string" />
            </sequence>
          </complexType>
        </element>
      </sequence>
    </complexType>
  </element>
</schema>